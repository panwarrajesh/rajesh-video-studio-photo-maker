# Cloud storage (optional). Leave S3_BUCKET empty to keep files on local disk.
# Works with AWS S3, Cloudflare R2, MinIO. The bucket must be publicly readable (or behind a CDN) at S3_PUBLIC_URL,
# and allow CORS GET from CLIENT_URL (needed for audio waveforms).
# S3_BUCKET=my-bucket
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_PUBLIC_URL=https://cdn.example.com
