{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://rajesh-video-studio-photo-maker.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://rajesh-video-studio-photo-maker.onrender.com/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
